# Azure Bot Service credentials
# Get these from https://portal.azure.com → Bot Services → your bot → Configuration
BOT_ID=your-bot-app-id
BOT_PASSWORD=your-bot-app-password

# OpenAI / Azure OpenAI
# Option 1: OpenAI directly
OPENAI_API_KEY=sk-...

# Option 2: Azure OpenAI (uncomment and fill)
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Lexiro MCP Server
LEXIRO_MCP_URL=https://lexiro.io/mcp
LEXIRO_API_KEY=ipx_your_api_key_here

# Server
PORT=3978
