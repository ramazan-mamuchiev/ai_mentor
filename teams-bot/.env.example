# Azure Bot Service credentials
# Get these from https://portal.azure.com → Bot Services → your bot → Configuration
BOT_ID=your-bot-app-id
BOT_PASSWORD=your-bot-app-password

# OpenAI / Azure OpenAI
# Option 1: OpenAI directly
OPENAI_API_KEY=sk-...

# Option 2: Azure OpenAI (uncomment and fill)
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# AI Mentor MCP Server
AI_MENTOR_MCP_URL=https://ai-mentor.ru/mcp
AI_MENTOR_API_KEY=ipx_your_api_key_here

# Access control
# Azure AD tenant ID — only users from this tenant can use the bot
ALLOWED_TENANT_ID=your-azure-ad-tenant-id
# Domain restriction — only users with this email domain are allowed
ALLOWED_DOMAIN=axxonsoft.dev

# Server
PORT=3978
