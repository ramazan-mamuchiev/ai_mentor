{
  "uid": "ipcodex-alerts",
  "title": "IPCodex Alerts & SLA",
  "tags": ["ipcodex", "alerts"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "SLA Gauges",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "gauge",
      "title": "Availability",
      "description": "Percentage of requests without 5xx errors in 24h. Target: 99.9%",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "total",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({container=\"/ipcodex-api-1\"} | json | event = \"Request completed\" [$__range]))",
          "queryType": "instant",
          "hide": true
        },
        {
          "refId": "errors",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({container=\"/ipcodex-api-1\"} | json | event = \"Request completed\" | status_code >= 500 [$__range]))",
          "queryType": "instant",
          "hide": true
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "reduce": {
              "reducer": "lastNotNull"
            },
            "binary": {
              "left": "errors",
              "operator": "/",
              "right": "total"
            },
            "alias": "error_rate"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "reduce": {
              "reducer": "lastNotNull"
            },
            "binary": {
              "left": "1",
              "operator": "-",
              "right": "error_rate"
            },
            "alias": "availability"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          },
          "unit": "percent",
          "min": 95,
          "max": 100,
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/.*availability.*/",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Latency SLA",
      "description": "Percentage of requests completing under 5 seconds in 24h",
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "fast",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({container=\"/ipcodex-api-1\"} | json | event = \"Request completed\" | unwrap duration_ms | duration_ms < 5000 [$__range]))",
          "queryType": "instant",
          "hide": true
        },
        {
          "refId": "total",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({container=\"/ipcodex-api-1\"} | json | event = \"Request completed\" [$__range]))",
          "queryType": "instant",
          "hide": true
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "reduce": {
              "reducer": "lastNotNull"
            },
            "binary": {
              "left": "fast",
              "operator": "/",
              "right": "total"
            },
            "alias": "latency_sla"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 95 }
            ]
          },
          "unit": "percent",
          "min": 80,
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/.*latency_sla.*/",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Error Budget",
      "description": "Remaining errors before SLA breach (99.9% target)",
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "total",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({container=\"/ipcodex-api-1\"} | json | event = \"Request completed\" [$__range]))",
          "queryType": "instant",
          "hide": true
        },
        {
          "refId": "errors",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({container=\"/ipcodex-api-1\"} | json | event = \"Request completed\" | status_code >= 500 [$__range]))",
          "queryType": "instant",
          "hide": true
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "reduce": {
              "reducer": "lastNotNull"
            },
            "binary": {
              "left": "total",
              "operator": "*",
              "right": "0.001"
            },
            "alias": "budget_total"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "reduce": {
              "reducer": "lastNotNull"
            },
            "binary": {
              "left": "budget_total",
              "operator": "-",
              "right": "errors"
            },
            "alias": "error_budget"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 5 }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/.*error_budget.*/",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      }
    },
    {
      "type": "row",
      "title": "Threshold Lines",
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 1 },
      "id": 101,
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error Rate with Threshold",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({container=\"/ipcodex-api-1\"} | json | event = \"Request completed\" | status_code >= 500 [5m])) / sum(count_over_time({container=\"/ipcodex-api-1\"} | json | event = \"Request completed\" [5m])) * 100",
          "legendFormat": "error rate %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "%",
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "scheme",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p95 Latency with Threshold",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "quantile_over_time(0.95, {container=\"/ipcodex-api-1\"} | json | event = \"Request completed\" | unwrap duration_ms [5m])",
          "legendFormat": "p95 duration_ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "ms",
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "scheme",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 10000 }
            ]
          },
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DB Pool with Threshold",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "last_over_time({container=\"/ipcodex-api-1\"} | json | logger = \"system\" | unwrap db_pool_checked_out [1m]) / last_over_time({container=\"/ipcodex-api-1\"} | json | logger = \"system\" | unwrap db_pool_size [1m]) * 100",
          "legendFormat": "pool utilization %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "%",
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "scheme",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 80 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "type": "row",
      "title": "Alert Status",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 1 },
      "id": 102,
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "alertlist",
      "title": "Alert List",
      "gridPos": { "x": 0, "y": 17, "w": 24, "h": 8 },
      "options": {
        "maxItems": 20,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "alertName": "",
        "showOptions": "current",
        "stateFilter": {
          "ok": true,
          "paused": true,
          "no_data": true,
          "execution_error": true,
          "alerting": true,
          "pending": true
        },
        "folder": {},
        "alertInstanceLabelFilter": "",
        "datasource": "",
        "viewMode": "list"
      }
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": []
}
