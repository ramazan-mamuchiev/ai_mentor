          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "avg_over_time({container=\"/ipcodex-api-1\"} | json | event = \"Search completed\" | unwrap top_similarity [5m]) by ()",
          "legendFormat": "avg top_similarity"
