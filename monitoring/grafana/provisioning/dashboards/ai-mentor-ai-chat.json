{
  "uid": "ai-mentor-ai-chat",
  "title": "AI Mentor Chat",
  "tags": ["ai_mentor", "chat", "llm"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
