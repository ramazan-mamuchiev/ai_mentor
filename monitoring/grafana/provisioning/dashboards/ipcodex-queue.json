      "type": "stat",
      "title": "Tasks Failed",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 27 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({container=\"/ipcodex-worker-1\"} | json | event = \"Task failed\" [$__range]))",
          "queryType": "instant"
