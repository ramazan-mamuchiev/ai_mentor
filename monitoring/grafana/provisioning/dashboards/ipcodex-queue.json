    {
      "id": 44,
      "type": "timeseries",
      "title": "Task Runtime Distribution",
      "description": "Runtime of each completed task over time",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 31 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
