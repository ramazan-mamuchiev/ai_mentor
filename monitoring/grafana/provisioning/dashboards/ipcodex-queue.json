{
  "uid": "ipcodex-queue",
  "title": "Lexiro Queue Monitor",
  "tags": ["ipcodex", "queue", "celery"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "15s",
  "schemaVersion": 39,
  "fiscalYearStartMonth": 0,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "panels": [
    {
      "type": "row",
      "title": "Current State",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Pending Count",
      "description": "Documents waiting in queue for worker pickup",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "last_over_time({container=\"/ipcodex-worker-1\"} | json | event = \"Queue snapshot\" | unwrap pending_count [$__range])",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "orange", "value": 15 },
              { "color": "red", "value": 30 }
            ]
          },
          "color": { "mode": "thresholds" },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Processing Count",
      "description": "Documents currently being processed by workers",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "last_over_time({container=\"/ipcodex-worker-1\"} | json | event = \"Queue snapshot\" | unwrap processing_count [$__range])",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          },
          "color": { "mode": "thresholds" },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Total Queued",
      "description": "Total documents in queue (pending + processing)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "last_over_time({container=\"/ipcodex-worker-1\"} | json | event = \"Queue snapshot\" | unwrap pending_count [$__range]) + last_over_time({container=\"/ipcodex-worker-1\"} | json | event = \"Queue snapshot\" | unwrap processing_count [$__range])",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          },
          "color": { "mode": "thresholds" },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Avg Queue Wait",
      "description": "Average time a task waits in queue before worker picks it up",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "avg_over_time({container=\"/ipcodex-worker-1\"} | json | event = \"Task picked from queue\" | unwrap queue_wait_ms [$__range])",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5000 },
              { "color": "red", "value": 30000 }
            ]
          },
          "color": { "mode": "thresholds" },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },

    {
      "type": "row",
      "title": "Queue Trends",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 2,
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Queue Depth Over Time",
      "description": "Pending and processing document counts from periodic snapshots",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "max_over_time({container=\"/ipcodex-worker-1\"} | json | event = \"Queue snapshot\" | unwrap pending_count [$__interval])",
          "legendFormat": "Pending",
          "queryType": "range"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "max_over_time({container=\"/ipcodex-worker-1\"} | json | event = \"Queue snapshot\" | unwrap processing_count [$__interval])",
          "legendFormat": "Processing",
          "queryType": "range"
        },
        {
          "refId": "C",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "max_over_time({container=\"/ipcodex-worker-1\"} | json | event = \"Queue snapshot\" | unwrap pending_count [$__interval]) + max_over_time({container=\"/ipcodex-worker-1\"} | json | event = \"Queue snapshot\" | unwrap processing_count [$__interval])",
          "legendFormat": "Total",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "Documents",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Total" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Queue Wait Time",
      "description": "Time each task spent waiting in the queue before being picked up by a worker",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "max_over_time({container=\"/ipcodex-worker-1\"} | json | event = \"Task picked from queue\" | unwrap queue_wait_ms [$__interval])",
          "legendFormat": "Wait time",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "points",
            "fillOpacity": 0,
            "lineWidth": 0,
            "pointSize": 8,
            "showPoints": "always",
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5000 },
              { "color": "red", "value": 30000 }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    },

    {
      "type": "row",
      "title": "Task Lifecycle",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 3,
      "collapsed": false,
      "panels": []
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Tasks Queued vs Completed",
      "description": "Rate of tasks entering and leaving the queue",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({container=~\"/ipcodex-(api|worker)-1\"} | json | event = \"Task queued\" | task_name = \"ingest_document\" [$__interval]))",
          "legendFormat": "Queued",
          "queryType": "range"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({container=~\"/ipcodex-(api|worker)-1\"} | json | event = \"Task completed\" | task_name = \"ingest_document\" | state = \"SUCCESS\" [$__interval]))",
          "legendFormat": "Completed",
          "queryType": "range"
        },
        {
          "refId": "C",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({container=~\"/ipcodex-(api|worker)-1\"} | json | event = \"Task failed\" [$__interval]))",
          "legendFormat": "Failed",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "Tasks",
            "axisPlacement": "auto",
            "drawStyle": "bars",
            "fillOpacity": 50,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Failed" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] }
      }
    },
    {
      "id": 31,
      "type": "table",
      "title": "Recent Task Events",
      "description": "Latest task lifecycle events across API and worker containers",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "{container=~\"/ipcodex-(api|worker)-1\"} | json | event =~ \"Task queued|Task picked from queue|Task completed|Task failed|Task retrying\"",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Event" },
            "properties": [
              { "id": "custom.width", "value": 200 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Timestamp" },
            "properties": [
              { "id": "custom.width", "value": 180 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" },
        "sortBy": [
          { "displayName": "Timestamp", "desc": true }
        ]
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "id": true,
              "tsNs": true,
              "labels": true,
              "logger": true,
              "level": true,
              "timestamp": true,
              "request_id": true,
              "reason": true,
              "worker_hostname": true
            },
            "indexByName": {
              "Time": 0,
              "event": 1,
              "task_name": 2,
              "task_id": 3,
              "document_id": 4,
              "state": 5,
              "queue_wait_ms": 6,
              "runtime_ms": 7,
              "retry_number": 8,
              "exception_type": 9
            },
            "renameByName": {
              "Time": "Timestamp",
              "event": "Event",
              "task_name": "Task",
              "task_id": "Task ID",
              "document_id": "Doc ID",
              "state": "State",
              "queue_wait_ms": "Wait (ms)",
              "runtime_ms": "Runtime (ms)",
              "retry_number": "Retry #",
              "exception_type": "Exception"
            }
          }
        }
      ]
    },

    {
      "type": "row",
      "title": "Worker Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 4,
      "collapsed": false,
      "panels": []
    },
