# === Database ===
# For Docker Compose: host is "postgres" (service name)
# For local dev: host is "localhost"
DATABASE_URL=postgresql+asyncpg://ipcodex:ipcodex_dev@postgres:5432/ipcodex
POSTGRES_PASSWORD=ipcodex_dev

# === Auth (MVP: single static key) ===
API_KEY=ipx_dev_key_12345

# === Embedding ===
# Provider: local (all-MiniLM-L6-v2) or openai
EMBEDDING_PROVIDER=local
# Only needed if EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# === Application ===
APP_ENV=production
APP_LOG_LEVEL=INFO

# === Logging ===
# Path on host for log files (bind-mounted into container)
# Local: ./logs  |  Server: /opt/ipcodex/logs
LOG_DIR=./logs
