# === Database ===
# For Docker Compose: host is "postgres" (service name)
# For local dev: host is "localhost"
DATABASE_URL=postgresql+asyncpg://ai-mentor:ai_mentor_dev@postgres:5432/ai_mentor
POSTGRES_PASSWORD=ai_mentor_dev

# === Auth (MVP: single static key) ===
API_KEY=ipx_dev_key_12345

# === Gemini API ===
# Single key used for both LLM (chat) and embeddings
GEMINI_API_KEY=

# === BotHub API ===
# Alternative LLM provider (https://bothub.ru)
BOTHUB_API_KEY=
BOTHUB_BASE_URL=https://bothub.chat/api/v2/openai/v1
BOTHUB_LLM_MODEL=gemini-2.5-flash
BOTHUB_EMBEDDING_MODEL=text-embedding-3-large

# === Embedding ===
EMBEDDING_DIMS=1024
EMBEDDING_MODEL_GEMINI=gemini-embedding-2-preview

# === Auth (JWT + OAuth) ===
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_BASE_URL=https://ai-mentor.ru

# === Email (Resend) ===
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# === Application ===
APP_ENV=production
APP_LOG_LEVEL=INFO

# === Logging ===
# Path on host for log files (bind-mounted into container)
# Local: ./logs  |  Server: /opt/ai-mentor/logs
LOG_DIR=./logs
